POSTGRES_USER=avtomalyar
POSTGRES_PASSWORD=avtomalyar
POSTGRES_DB=avtomalyar

# Host port Postgres is published on (container always listens on 5432
# internally). Default 5433 to avoid clashing with a local Postgres install.
POSTGRES_HOST_PORT=5433

# Change this to a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret

# The session cookie is sent over HTTPS only. Keep "true" behind HTTPS.
# Set "false" only for a test stand opened over plain HTTP by IP or host
# name — otherwise the browser drops the cookie and login does not stick.
# (http://localhost works either way.)
AUTH_COOKIE_SECURE=true

# Used by `make migrate-*` and `make seed-*` running from the host.
DATABASE_URL=postgres://avtomalyar:avtomalyar@localhost:5433/avtomalyar?sslmode=disable
